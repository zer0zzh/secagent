# 复制为 .env 后填写。.env 不要提交、不要贴进聊天记录。
# 变量名与 config/llm.yaml 里的 ${...} 一一对应。

# SQLite 数据文件位置（留空则用 secagent/data/secagent.db）
SECAGENT_DB=

# 当前生效 profile：mock | workbuddy | deepseek | openai_compatible | ollama
SECAGENT_PROFILE=ollama

# DeepSeek 官方 API（阶段1 主力）
DEEPSEEK_API_KEY=

# 任意 OpenAI 兼容网关
OPENAI_API_KEY=

# 本机 ollama（断网兜底，无需密钥；实际 tag 带 -instruct）
# SECAGENT_LLM_OLLAMA_MODEL=qwen2.5:7b-instruct

# 本地假服务
SECAGENT_MOCK_KEY=not-needed

# WorkBuddy 免密钥通道（浏览器 SDK 专用，CLI 不可直连，仅留档）
# SECAGENT_WB_ENDPOINT=
# SECAGENT_WB_PUBLISHABLE_KEY=
# SECAGENT_WB_MODEL=
